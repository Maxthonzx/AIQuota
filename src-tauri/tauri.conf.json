{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AIQuota",
  "version": "1.5.1",
  "identifier": "dev.aiquota.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "AIQuota",
        "width": 1120,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "windows": {
      "minimumWebview2Version": "111.0.0.0",
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": [
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.md",
      "../third-party/licenses/"
    ]
  }
}
